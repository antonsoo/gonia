{
  "name": "@antonsoloviev/gonia",
  "version": "0.15.0",
  "private": true,
  "description": "Measured ancient architecture: Greek temple geometry, Babylonian building evidence, transport, acoustics and water screws.",
  "type": "module",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/gonia.git"
  },
  "homepage": "https://antonsoo.github.io/gonia/",
  "keywords": [
    "architecture",
    "ancient-greek",
    "doric",
    "vitruvius",
    "education",
    "geometry",
    "babylon",
    "etemenanki",
    "akkadian"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4328 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4328 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:geometry": "node --import tsx scripts/geometry-cases.ts | python3 scripts/geometry-oracle.py",
    "test:browser": "node scripts/browser-check.mjs",
    "verify:spacing": "node --import tsx scripts/spacing-cases.ts | python3 scripts/spacing-oracle.py",
    "test:spacing": "node scripts/spacing-browser.mjs",
    "verify:entasis": "node --import tsx scripts/entasis-cases.ts | python3 scripts/entasis-oracle.py",
    "test:entasis": "node scripts/entasis-browser.mjs",
    "verify:fluting": "node --import tsx scripts/fluting-cases.ts | python3 scripts/fluting-oracle.py",
    "test:fluting": "node scripts/fluting-browser.mjs",
    "verify:segments": "node --import tsx scripts/segments-cases.ts | python3 scripts/segments-oracle.py",
    "test:segments": "node scripts/segments-browser.mjs",
    "verify:transport": "node --import tsx scripts/transport-cases.ts | python3 scripts/transport-oracle.py",
    "test:transport": "node scripts/transport-browser.mjs",
    "verify:colonnade": "node --import tsx scripts/colonnade-cases.ts | python3 scripts/colonnade-oracle.py",
    "test:colonnade": "node scripts/colonnade-browser.mjs",
    "verify:theatre": "node --import tsx scripts/theatre-cases.ts | python3 scripts/theatre-oracle.py",
    "test:theatre": "node scripts/theatre-browser.mjs",
    "verify:echea": "node --import tsx scripts/echea-cases.ts | python3 scripts/echea-oracle.py",
    "test:echea": "node scripts/echea-browser.mjs",
    "verify:hoist": "node --import tsx scripts/hoist-cases.ts | python3 scripts/hoist-oracle.py",
    "test:hoist": "node scripts/hoist-browser.mjs",
    "test:hoist-upgrade": "node scripts/hoist-upgrade.mjs",
    "verify:hoist-files": "python3 scripts/hoist-artifact-oracle.py",
    "verify:optics": "node --import tsx scripts/optics-cases.ts | python3 scripts/optics-oracle.py",
    "test:optics": "node scripts/optics-browser.mjs",
    "verify:screw": "node --import tsx scripts/screw-cases.ts | python3 scripts/screw-oracle.py",
    "test:screw": "node scripts/screw-browser.mjs",
    "test:screw-upgrade": "node scripts/screw-upgrade.mjs",
    "verify:screw-files": "python3 scripts/screw-artifacts.py",
    "verify:ledger": "node --import tsx scripts/ledger-cases.ts | python3 scripts/ledger-oracle.py",
    "test:ledger": "node scripts/ledger-browser.mjs",
    "verify:ledger-files": "python3 scripts/ledger-artifacts.py",
    "verify:babylon": "node --import tsx scripts/babylon-cases.ts | python3 scripts/babylon-oracle.py",
    "test:babylon": "node scripts/babylon-browser.mjs",
    "verify:babylon-files": "python3 scripts/babylon-artifacts.py",
    "test:volute": "node scripts/volute-browser.mjs",
    "verify:volute-files": "python3 scripts/volute-artifacts.py",
    "prepare:volute-sources": "python3 scripts/volute-sources.py",
    "verify:arch": "node --import tsx scripts/arch-cases.ts | uv run --with scipy==1.18.1 scripts/arch-oracle.py",
    "test:arch": "node scripts/arch-browser.mjs",
    "verify:hoist-loss": "node --import tsx scripts/hoist-loss-cases.ts | python3 scripts/hoist-loss-oracle.py",
    "test:hoist-loss": "node scripts/hoist-loss-browser.mjs",
    "test:offline-audit": "node scripts/offline-audit.mjs",
    "test:offline-rooms": "node scripts/offline-rooms-audit.mjs",
    "test:offline-upgrade-audit": "node scripts/offline-upgrade-audit.mjs",
    "test:cold-source": "node scripts/cold-source-audit.mjs",
    "verify:arch-friction": "node --import tsx scripts/arch-friction-cases.ts | uv run --with scipy==1.18.1 scripts/arch-friction-oracle.py",
    "test:arch-friction": "node scripts/arch-friction-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
